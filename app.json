{
  "expo": {
    "name": "UtilityVision",
    "slug": "fieldworker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "utilityvision",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1C1E"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "UtilityVision needs camera access to capture site photos and signatures.",
        "NSPhotoLibraryUsageDescription": "UtilityVision needs photo library access to attach site photos.",
        "NSPhotoLibraryAddUsageDescription": "UtilityVision needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.wickedfl.utilityvision"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1C1E"
      },
      "package": "com.wickedfl.utilityvision",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UtilityVision to access your photos for site documentation.",
          "cameraPermission": "Allow UtilityVision to access your camera for site photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow UtilityVision to access your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UtilityVision tags photos with GPS coordinates for site documentation."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": false
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f39e81fc-3f4c-4c8d-ae41-cfaac78e5c03"
      }
    }
  }
}
